# Exemplo de configuração para o BUILD de STAGING — nunca commitar o
# `.env`/`.env.local` real gerado a partir disto (ver `.gitignore`). Ao
# contrário do backend, estas variáveis ficam embutidas no bundle
# estático no momento do `npm run build` (nunca lidas em runtime) — por
# isso o processo de build de staging tem de as definir antes de
# construir (variáveis de ambiente do CI/CD, ou um `.env.local` só nessa
# máquina de build, nunca commitado). Ver docs/STAGING_RUNBOOK.md.
#
# Diferenças-chave face a `frontend/.env.example` (local/dev):
#   VITE_API_BASE_URL aponta ao backend de staging (não localhost),
#   VITE_ENTRA_* preenchidos com a app registration SPA real,
#   VITE_ENABLE_DEV_LOGIN=false explícito (nunca omitido num build de
#   staging, para não haver dúvida ao rever a configuração de build).

VITE_API_BASE_URL=https://<dominio-do-backend-de-staging>

# App registration SPA (Single-page application) — nunca a mesma da API
# do backend. Ver docs/STAGING_RUNBOOK.md secção "Microsoft Entra ID".
VITE_ENTRA_CLIENT_ID=<client-id-da-app-registration-spa>
VITE_ENTRA_TENANT_ID=<tenant-id-do-azure-ad>
# Application ID URI da app registration da API (backend) + "/access_as_user".
VITE_ENTRA_API_SCOPE=api://<client-id-da-app-registration-da-api>/access_as_user
# Opcional — só definir se o URL de staging não for a raiz do domínio.
VITE_ENTRA_REDIRECT_URI=

# O login de desenvolvimento (X-Dev-User-Email) nunca deve chegar a um
# build de staging/produção — já fica desligado por omissão fora de
# `vite dev`/testes (devLoginEnabled, D-033), mas definir explicitamente
# `false` aqui remove qualquer ambiguidade ao rever a configuração deste
# build.
VITE_ENABLE_DEV_LOGIN=false
