# Copiar para .env.local e ajustar. Nunca commitar .env/.env.local (ver .gitignore).
VITE_API_BASE_URL=http://localhost:8000
VITE_DEV_USER_EMAIL=chefe.sintetico@example.invalid

# Login real Microsoft Entra ID (MSAL, Authorization Code + PKCE — ver
# src/auth/msal.ts). Sem tenant/app registration reais disponíveis neste
# repositório (docs/OPEN_QUESTIONS.md, pergunta 1) — deixar vazio faz o
# botão "Entrar com Microsoft" aparecer desativado, sem inventar
# credenciais. Preencher só quando um tenant real existir:
#   VITE_ENTRA_CLIENT_ID=<client id da app registration SPA>
#   VITE_ENTRA_TENANT_ID=<tenant id>
#   VITE_ENTRA_API_SCOPE=api://<client id da API>/access_as_user
# VITE_ENTRA_REDIRECT_URI é opcional (por omissão, a própria origem).
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_API_SCOPE=
VITE_ENTRA_REDIRECT_URI=

# Login de desenvolvimento (X-Dev-User-Email): ligado por omissão em
# `vite dev`/testes, desligado por omissão num build de produção. Só
# definir explicitamente para testar um build de produção contra um
# backend local/test.
VITE_ENABLE_DEV_LOGIN=
