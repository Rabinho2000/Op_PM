# Copiar para .env e ajustar localmente. NUNCA commitar o .env real
# (ver .gitignore). Nenhum valor abaixo é um segredo real — são só exemplos
# ou vazios.

# --- Aplicação ---
APP_ENV=local
APP_NAME="Op_PM API"
# Gerar um valor próprio em staging/produção — nunca usar o valor por omissão do código fora de local/test.
SECRET_KEY=dev-only-insecure-secret-change-me
# Alternativa a SECRET_KEY: caminho de um ficheiro com o valor (uma linha).
# Não definir as duas. Preferível em staging/produção (segredo fora do .env).
SECRET_KEY_FILE=
# Modo demonstração (dados sintéticos, só APP_ENV=local) e aviso de dados reais.
DEMO_MODE=false
DEMO_REAL_DATA=false

# --- Base de dados ---
# Local/test (omissão): SQLite em ficheiro, sem serviços externos.
# Staging/produção: PostgreSQL — ver docs/DECISIONS.md.
DATABASE_URL=sqlite:///./data/op_pm_local.db
# Exemplo para PostgreSQL (staging/produção), quando disponível:
# DATABASE_URL=postgresql+psycopg://op_pm:CHANGE_ME@localhost:5432/op_pm
# Alternativas que mantêm a password fora do .env (não combinar com a
# variável inline correspondente):
#   DATABASE_URL_FILE: ficheiro com o URL completo (uma linha).
#   DATABASE_PASSWORD_FILE: ficheiro só com a password; o DATABASE_URL não pode
#   trazer password e tem de ser PostgreSQL.
DATABASE_URL_FILE=
DATABASE_PASSWORD_FILE=

# --- Autenticação (Microsoft Entra ID) — Fase 1: validação real implementada,
# falta o tenant (ver docs/OPEN_QUESTIONS.md, pergunta 1) ---
AUTH_ENABLED=false
# 'real': valida contra o tenant Entra ID de verdade (exige ENTRA_TENANT_ID/
# ENTRA_CLIENT_ID). 'mock': valida contra uma chave de teste local, sem rede —
# só aceitável em local/test (bloqueado em staging/produção — D-024).
ENTRA_VALIDATION_MODE=real
# Em staging/produção, ENTRA_TENANT_ID, ENTRA_CLIENT_ID e
# ENTRA_REQUIRED_SCOPE têm de estar preenchidos — o arranque falha com uma
# mensagem clara se faltar algum (D-032, docs/STAGING_CHECKLIST.md).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Escopo delegado exigido no claim 'scp' do token (ex.: access_as_user —
# ver a app registration da API). Obrigatório em staging/produção.
ENTRA_REQUIRED_SCOPE=
# Normalmente derivados de ENTRA_TENANT_ID/ENTRA_CLIENT_ID — só definir
# explicitamente para um cenário não-standard, e sempre os três juntos
# (D-032): definir só um destes três em staging/produção impede o arranque.
ENTRA_ISSUER=
ENTRA_JWKS_URL=
ENTRA_AUDIENCE=
# Ligação automática de um utilizador por email no primeiro login (JIT).
# Vazio: ligado em local/test, desligado em staging/produção.
ENTRA_JIT_LINK_BY_EMAIL=

# --- CORS (frontend a falar com esta API) ---
# Vazio em local/test: liberta sempre http://localhost:5173 automaticamente.
# Em staging/produção, listar as origens permitidas, separadas por vírgula —
# obrigatório (D-032): o arranque falha se ficar vazio nestes ambientes.
CORS_ALLOWED_ORIGINS=

# --- Microsoft Graph: envio do relatório semanal ---
# GRAPH_ENABLED=false grava um .eml em GRAPH_FALLBACK_DIR (nada é enviado).
GRAPH_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# Caminho de um ficheiro com o segredo (uma linha) — nunca o valor inline.
GRAPH_CLIENT_SECRET_FILE=
GRAPH_FALLBACK_DIR=./data/outbox

# --- Relatório semanal: scheduler (python -m app.cli.client_reports loop) ---
# Utilizador de serviço com client_report.manage + project.view_all/edit_all.
CLIENT_REPORT_SCHEDULER_EMAIL=
# Vazio: <pasta de dados>/client_report_scheduler.heartbeat
CLIENT_REPORT_SCHEDULER_HEARTBEAT_FILE=

# --- Ficheiros e segredos locais ---
# Chave Fernet (ficheiro, uma linha) para passwords de portais e PIN/PUK. Vazio: 503 ao gravar/revelar.
OPPM_SECRETS_KEY_FILE=
# Motor privado de dimensionamento de cabos (ficheiro .js fora do Git).
CABLE_TOOL_FILE=
PROJECT_PHOTO_DIR=./data/project_photos
INVENTORY_FILE_DIR=./data/inventory

# --- Mapa operacional (sem provider: o frontend mostra só a lista de locais) ---
MAP_PROVIDER_ENABLED=false
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=

# --- Operação ---
LOG_LEVEL=INFO
# /docs e /openapi.json. Vazio: só em local/test sem DEMO_REAL_DATA.
API_DOCS_ENABLED=

# --- Integrações por implementar ---
# CLICKUP_ENABLED, FINANCIAL_ENABLED e CLAUDE_ENABLED não ligam a nada: a
# aplicação recusa-se a arrancar se alguma for 'true'.
# ClickUp: integração adiada (só existe um mock com fixture sintética).
CLICKUP_ENABLED=false
CLICKUP_TOKEN=
CLICKUP_LIST_ID=

# --- Financial: por implementar ---
FINANCIAL_ENABLED=false
FINANCIAL_MODE=mock
FINANCIAL_CSV_PATH=
FINANCIAL_API_BASE_URL=
FINANCIAL_API_KEY=

# --- Claude: por implementar ---
CLAUDE_ENABLED=false
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
