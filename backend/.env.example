# Copiar para .env e ajustar localmente. NUNCA commitar o .env real
# (ver .gitignore). Nenhum valor abaixo é um segredo real — são só exemplos
# ou vazios.

# --- Aplicação ---
APP_ENV=local
APP_NAME="Op_PM API"
# Gerar um valor próprio em staging/produção — nunca usar o valor por omissão do código fora de local/test.
SECRET_KEY=dev-only-insecure-secret-change-me

# --- Base de dados ---
# Local/test (omissão): SQLite em ficheiro, sem serviços externos.
# Staging/produção: PostgreSQL — ver docs/DECISIONS.md.
DATABASE_URL=sqlite:///./data/op_pm_local.db
# Exemplo para PostgreSQL (staging/produção), quando disponível:
# DATABASE_URL=postgresql+psycopg://op_pm:CHANGE_ME@localhost:5432/op_pm

# --- Autenticação (Microsoft Entra ID) — Fase 1: validação real implementada,
# falta o tenant (ver docs/OPEN_QUESTIONS.md, pergunta 1) ---
AUTH_ENABLED=false
# 'real': valida contra o tenant Entra ID de verdade (exige ENTRA_TENANT_ID/
# ENTRA_CLIENT_ID). 'mock': valida contra uma chave de teste local, sem rede —
# só aceitável em local/test (bloqueado em staging/produção — D-024).
ENTRA_VALIDATION_MODE=real
# Em staging/produção, ENTRA_TENANT_ID, ENTRA_CLIENT_ID e
# ENTRA_REQUIRED_SCOPE têm de estar preenchidos — o arranque falha com uma
# mensagem clara se faltar algum (D-032, docs/STAGING_CHECKLIST.md).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Escopo delegado exigido no claim 'scp' do token (ex.: access_as_user —
# ver a app registration da API). Obrigatório em staging/produção.
ENTRA_REQUIRED_SCOPE=
# Normalmente derivados de ENTRA_TENANT_ID/ENTRA_CLIENT_ID — só definir
# explicitamente para um cenário não-standard, e sempre os três juntos
# (D-032): definir só um destes três em staging/produção impede o arranque.
ENTRA_ISSUER=
ENTRA_JWKS_URL=
ENTRA_AUDIENCE=

# --- CORS (frontend a falar com esta API) ---
# Vazio em local/test: liberta sempre http://localhost:5173 automaticamente.
# Em staging/produção, listar as origens permitidas, separadas por vírgula —
# obrigatório (D-032): o arranque falha se ficar vazio nestes ambientes.
CORS_ALLOWED_ORIGINS=

# --- Microsoft Graph (email/calendário/documentos) — Fase 0: fallback local ---
GRAPH_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_FALLBACK_DIR=./data/outbox

# --- ClickUp — Fase 0: mock com fixture sintética ---
CLICKUP_ENABLED=false
CLICKUP_TOKEN=
CLICKUP_LIST_ID=

# --- Financial — Fase 0: mock, ou CSV sintético para testar o modo real ---
FINANCIAL_ENABLED=false
FINANCIAL_MODE=mock
FINANCIAL_CSV_PATH=
FINANCIAL_API_BASE_URL=
FINANCIAL_API_KEY=

# --- Claude — Fase 0: mock, sem chamadas reais ---
CLAUDE_ENABLED=false
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
