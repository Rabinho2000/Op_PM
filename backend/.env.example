# Copiar para .env e ajustar localmente. NUNCA commitar o .env real
# (ver .gitignore). Nenhum valor abaixo é um segredo real — são só exemplos
# ou vazios.

# --- Aplicação ---
APP_ENV=local
APP_NAME="Op_PM API"
# Gerar um valor próprio em staging/produção — nunca usar o valor por omissão do código fora de local/test.
SECRET_KEY=dev-only-insecure-secret-change-me

# --- Base de dados ---
# Local/test (omissão): SQLite em ficheiro, sem serviços externos.
# Staging/produção: PostgreSQL — ver docs/DECISIONS.md.
DATABASE_URL=sqlite:///./data/op_pm_local.db
# Exemplo para PostgreSQL (staging/produção), quando disponível:
# DATABASE_URL=postgresql+psycopg://op_pm:CHANGE_ME@localhost:5432/op_pm

# --- Autenticação (Microsoft Entra ID) — Fase 0: por implementar ---
AUTH_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- Microsoft Graph (email/calendário/documentos) — Fase 0: fallback local ---
GRAPH_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_FALLBACK_DIR=./data/outbox

# --- ClickUp — Fase 0: mock com fixture sintética ---
CLICKUP_ENABLED=false
CLICKUP_TOKEN=
CLICKUP_LIST_ID=

# --- Financial — Fase 0: mock, ou CSV sintético para testar o modo real ---
FINANCIAL_ENABLED=false
FINANCIAL_MODE=mock
FINANCIAL_CSV_PATH=
FINANCIAL_API_BASE_URL=
FINANCIAL_API_KEY=

# --- Claude — Fase 0: mock, sem chamadas reais ---
CLAUDE_ENABLED=false
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
