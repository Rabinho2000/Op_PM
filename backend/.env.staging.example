# Exemplo de configuração para STAGING — nunca copiar valores daqui tal
# como estão, e nunca commitar o `.env` real gerado a partir disto (ver
# `.gitignore`). Todos os placeholders abaixo (`<...>`) têm de ser
# substituídos por valores reais antes de arrancar; a aplicação recusa-se
# a arrancar em APP_ENV=staging/production com qualquer um destes em
# falta ou com um valor de desenvolvimento (`app/config.py`,
# `docs/DECISIONS.md` D-020/D-032). Ver `docs/STAGING_RUNBOOK.md` para o
# procedimento completo passo-a-passo (App registrations Entra ID,
# PostgreSQL, migrações, os 5 utilizadores, testes de aceitação).
#
# Diferenças-chave face a `backend/.env.example` (local/dev):
#   APP_ENV=staging (não `local`), AUTH_ENABLED=true (não `false`),
#   DATABASE_URL aponta a um PostgreSQL dedicado (nunca SQLite),
#   ENTRA_VALIDATION_MODE=real (não `mock`), CORS_ALLOWED_ORIGINS
#   preenchido com o domínio real de staging (nunca vazio nem `*`).

# --- Aplicação ---
APP_ENV=staging
APP_NAME="Op_PM API — Staging"
# Gerar um valor próprio e único para staging — NUNCA o valor de
# `.env.example`, NUNCA reutilizado de produção:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<gerar-um-valor-aleatorio-proprio-de-staging>

# --- Base de dados: PostgreSQL obrigatório em staging (nunca SQLite) ---
# Utilizador e base de dados dedicados a staging — nunca partilhados com
# produção (ver docs/STAGING_RUNBOOK.md secção "PostgreSQL").
DATABASE_URL=postgresql+psycopg://<utilizador>:<password>@<host>:5432/<nome-da-bd-staging>

# --- Autenticação (Microsoft Entra ID) — obrigatória e real em staging ---
AUTH_ENABLED=true
# 'real' é o único modo aceite em staging/produção — 'mock' está
# bloqueado no arranque nestes ambientes (D-024).
ENTRA_VALIDATION_MODE=real
# Ver docs/STAGING_RUNBOOK.md secção "Microsoft Entra ID" para como obter
# estes três valores (App registration da API, não a da SPA).
ENTRA_TENANT_ID=<tenant-id-do-azure-ad>
ENTRA_CLIENT_ID=<client-id-da-app-registration-da-api>
# Reservado para uma futura integração backend-a-backend (client
# credentials) — nenhum caminho atual (validação de token, D-024/D-029)
# precisa disto. Deixar vazio a menos que uma fase futura o exija
# explicitamente; a app registration da API nunca deve ter um secret
# gerado só para satisfazer este campo.
ENTRA_CLIENT_SECRET=
# Tem de corresponder ao nome do scope delegado exposto pela app
# registration da API (docs/STAGING_RUNBOOK.md secção "Microsoft Entra
# ID" passo 2) — o valor recomendado e usado em todos os exemplos é
# `access_as_user`.
ENTRA_REQUIRED_SCOPE=access_as_user
# Derivados automaticamente de ENTRA_TENANT_ID/ENTRA_CLIENT_ID — deixar
# vazios a menos que exista um motivo concreto para um override manual;
# se definir um, definir sempre os três juntos (nunca só um — bloqueado
# no arranque, D-032).
ENTRA_ISSUER=
ENTRA_JWKS_URL=
ENTRA_AUDIENCE=
# JIT linking (ligação automática de um utilizador por email a partir de
# um token válido, sem confirmação manual) fica desligado por omissão em
# staging/produção (D-029) — só ativar aqui com uma decisão de negócio
# documentada em docs/DECISIONS.md, nunca por conveniência.
# ENTRA_JIT_LINK_BY_EMAIL=false

# --- CORS: só o(s) domínio(s) reais do frontend de staging ---
# Nunca vazio, nunca "*" — separar por vírgula se houver mais do que um
# (ex. um domínio "apex" e um "www").
CORS_ALLOWED_ORIGINS=https://<dominio-do-frontend-de-staging>

# --- Integrações externas: todas desligadas nesta fase ---
# Nenhuma integração real é ativada em staging por este runbook — ver
# docs/PLAN.md para o roadmap de cada uma. Ativar qualquer uma sem a
# implementação correspondente levanta NotImplementedError de propósito.
GRAPH_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_FALLBACK_DIR=./data/outbox

CLICKUP_ENABLED=false
CLICKUP_TOKEN=
CLICKUP_LIST_ID=

FINANCIAL_ENABLED=false
FINANCIAL_MODE=mock
FINANCIAL_CSV_PATH=
FINANCIAL_API_BASE_URL=
FINANCIAL_API_KEY=

CLAUDE_ENABLED=false
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
